{
  "requests": [
    {
      "method": "POST",
      "path": "/chat/completions",
      "header": {
        "Accept-Encoding": "gzip",
        "Authorization": "Bearer together-wire-key",
        "Content-Type": "application/json",
        "User-Agent": "go-llmprovider-sdk/<version> (<os>; <arch>) go-llmprovider-sdk/<version>"
      },
      "body": {
        "max_tokens": 8192,
        "messages": [
          {
            "content": "What is the weather in Paris?",
            "role": "user"
          }
        ],
        "model": "openai/gpt-oss-120b",
        "tool_choice": {
          "function": {
            "name": "get_weather"
          },
          "type": "function"
        },
        "tools": [
          {
            "function": {
              "description": "Weather for a city",
              "name": "get_weather",
              "parameters": {
                "properties": {
                  "city": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "function"
          }
        ]
      }
    }
  ],
  "result": "{\"city\":\"Paris\"}"
}
